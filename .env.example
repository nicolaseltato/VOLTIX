# Credenciales de la aplicación creada en https://developers.mercadolibre.com.ar/devcenter
ML_APP_ID=
ML_CLIENT_SECRET=

# Debe coincidir EXACTO con el Redirect URI configurado en la aplicación
ML_REDIRECT_URI=https://localhost/callback

# Site ID de tu cuenta (Argentina = MLA, México = MLM, Brasil = MLB, Chile = MLC, Colombia = MCO, etc.)
ML_SITE_ID=MLA

# product_id del recurso de anunciantes a consultar: PADS (Product Ads), DISPLAY o BADS (Brand Ads)
ML_PRODUCT_ID=PADS
